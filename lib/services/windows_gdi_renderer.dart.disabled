import 'dart:ffi';
import 'dart:typed_data';
import 'package:ffi/ffi.dart';
import 'package:win32/win32.dart';
import 'package:flutter/foundation.dart';
import '../models/page_dimensions.dart';
import '../models/windows_printer.dart';
import 'print_dimension_calculator.dart';

/// Windows GDI-based rendering engine for exact-size printing
/// Provides pixel-perfect control over printed output without scaling
class WindowsGdiRenderer {
  static final WindowsGdiRenderer _instance = WindowsGdiRenderer._internal();
  factory WindowsGdiRenderer() => _instance;
  WindowsGdiRenderer._internal();

  /// Print PDF bytes to specified printer with exact dimensions
  Future<bool> printPdfExactSize({
    required Uint8List pdfBytes,
    required WindowsPrinter printer,
    required PrintSettings settings,
    String? documentName,
  }) async {
    try {
      final docName = documentName ?? 'Flutter Exact Print';

      // Create printer device context
      final printerDC = await _createPrinterDC(printer.name);
      if (printerDC == null) {
        debugPrint('Failed to create printer device context');
        return false;
      }

      // Calculate exact pixel dimensions
      final pixelDims = PrintDimensionCalculator.calculatePixelDimensions(
        settings.pageSize,
        settings.dpi,
        margins: settings.margins,
      );

      // Configure device context for exact printing
      if (!_configurePrinterDC(printerDC, settings, pixelDims)) {
        DeleteDC(printerDC);
        return false;
      }

      // Start document
      final docInfo = calloc<DOCINFO>();
      final pDocName = docName.toNativeUtf16();

      docInfo.ref.cbSize = sizeOf<DOCINFO>();
      docInfo.ref.lpszDocName = pDocName;
      docInfo.ref.lpszOutput = nullptr;
      docInfo.ref.lpszDatatype = nullptr;
      docInfo.ref.fwType = 0;

      final jobId = StartDoc(printerDC, docInfo);

      calloc.free(pDocName);
      calloc.free(docInfo);

      if (jobId <= 0) {
        final error = GetLastError();
        debugPrint('StartDoc failed with error: $error');
        DeleteDC(printerDC);
        return false;
      }

      // Start page
      if (StartPage(printerDC) <= 0) {
        final error = GetLastError();
        debugPrint('StartPage failed with error: $error');
        EndDoc(printerDC);
        DeleteDC(printerDC);
        return false;
      }

      // Render PDF content to device context
      final renderSuccess = await _renderPdfToContext(
        printerDC,
        pdfBytes,
        pixelDims,
        settings,
      );

      // End page and document
      EndPage(printerDC);
      EndDoc(printerDC);
      DeleteDC(printerDC);

      return renderSuccess;
    } catch (e) {
      debugPrint('Error in printPdfExactSize: $e');
      return false;
    }
  }

  /// Print template with exact field positioning
  Future<bool> printTemplateExactSize({
    required Map<String, dynamic> templateData,
    required List<TemplateField> fields,
    required WindowsPrinter printer,
    required PrintSettings settings,
    String? documentName,
  }) async {
    try {
      final docName = documentName ?? 'Template Print';

      // Create printer device context
      final printerDC = await _createPrinterDC(printer.name);
      if (printerDC == NULL) {
        debugPrint('Failed to create printer device context');
        return false;
      }

      // Calculate exact pixel dimensions
      final pixelDims = PrintDimensionCalculator.calculatePixelDimensions(
        settings.pageSize,
        settings.dpi,
        margins: settings.margins,
      );

      // Configure device context
      if (!_configurePrinterDC(printerDC, settings, pixelDims)) {
        DeleteDC(printerDC);
        return false;
      }

      // Start document
      final docInfo = calloc<DOCINFO>();
      final pDocName = documentName?.toNativeUtf16() ?? 'Template Print'.toNativeUtf16();

      docInfo.ref.cbSize = sizeOf<DOCINFO>();
      docInfo.ref.lpszDocName = pDocName;
      docInfo.ref.lpszOutput = nullptr;
      docInfo.ref.lpszDatatype = nullptr;
      docInfo.ref.fwType = 0;

      final jobId = StartDoc(printerDC, docInfo);

      calloc.free(pDocName);
      calloc.free(docInfo);

      if (jobId <= 0) {
        DeleteDC(printerDC);
        return false;
      }

      // Start page
      if (StartPage(printerDC) <= 0) {
        EndDoc(printerDC);
        DeleteDC(printerDC);
        return false;
      }

      // Render template fields
      final renderSuccess = _renderTemplateFields(
        printerDC,
        templateData,
        fields,
        pixelDims,
        settings,
      );

      // End page and document
      EndPage(printerDC);
      EndDoc(printerDC);
      DeleteDC(printerDC);

      return renderSuccess;
    } catch (e) {
      debugPrint('Error in printTemplateExactSize: $e');
      return false;
    }
  }

  /// Create printer device context
  Future<int?> _createPrinterDC(String printerName) async {
    try {
      final pPrinterName = printerName.toNativeUtf16();
      final hdc = CreateDC('WINSPOOL'.toNativeUtf16(), pPrinterName, nullptr, nullptr);

      calloc.free(pPrinterName);

      return hdc != NULL ? hdc : null;
    } catch (e) {
      debugPrint('Error creating printer DC: $e');
      return null;
    }
  }

  /// Configure printer device context for exact printing
  bool _configurePrinterDC(int hdc, PrintSettings settings, PixelDimensions pixelDims) {
    try {
      // Set map mode to pixels for exact control
      SetMapMode(hdc, MM_TEXT);

      // Set graphics mode for advanced features
      SetGraphicsMode(hdc, GM_ADVANCED);

      // Configure coordinate system for exact dimensions
      SetWindowExtEx(hdc, pixelDims.totalWidthPixels, pixelDims.totalHeightPixels, nullptr);
      SetViewportExtEx(hdc, pixelDims.totalWidthPixels, pixelDims.totalHeightPixels, nullptr);

      // Set high quality rendering
      SetStretchBltMode(hdc, HALFTONE);
      SetBrushOrgEx(hdc, 0, 0, nullptr);

      return true;
    } catch (e) {
      debugPrint('Error configuring printer DC: $e');
      return false;
    }
  }

  /// Render PDF content to device context (simplified for now)
  Future<bool> _renderPdfToContext(
    int hdc,
    Uint8List pdfBytes,
    PixelDimensions pixelDims,
    PrintSettings settings,
  ) async {
    try {
      // For now, we'll create a simple placeholder rendering
      // In a full implementation, this would parse and render the PDF

      // Create a white background
      final hBrush = CreateSolidBrush(RGB(255, 255, 255));
      final rect = calloc<RECT>();
      rect.ref.left = 0;
      rect.ref.top = 0;
      rect.ref.right = pixelDims.totalWidthPixels;
      rect.ref.bottom = pixelDims.totalHeightPixels;

      FillRect(hdc, rect, hBrush);

      DeleteObject(hBrush);
      calloc.free(rect);

      // Add a border for debugging
      final hPen = CreatePen(PS_SOLID, 1, RGB(0, 0, 0));
      final hOldPen = SelectObject(hdc, hPen);

      Rectangle(hdc,
        pixelDims.leftMarginPixels,
        pixelDims.topMarginPixels,
        pixelDims.leftMarginPixels + pixelDims.printableWidthPixels,
        pixelDims.topMarginPixels + pixelDims.printableHeightPixels
      );

      SelectObject(hdc, hOldPen);
      DeleteObject(hPen);

      return true;
    } catch (e) {
      debugPrint('Error rendering PDF to context: $e');
      return false;
    }
  }

  /// Render template fields to device context
  bool _renderTemplateFields(
    int hdc,
    Map<String, dynamic> templateData,
    List<TemplateField> fields,
    PixelDimensions pixelDims,
    PrintSettings settings,
  ) {
    try {
      // Set text background to transparent
      SetBkMode(hdc, TRANSPARENT);

      for (final field in fields) {
        final value = templateData[field.fieldName]?.toString() ?? '';
        if (value.isEmpty) continue;

        // Calculate field position in pixels
        final position = PrintDimensionCalculator.convertFieldPosition(
          field.x,
          field.y,
          pixelDims,
        );

        // Create font for this field
        final hFont = _createFieldFont(field, settings.dpi);
        final hOldFont = SelectObject(hdc, hFont);

        // Set text color
        SetTextColor(hdc, RGB(0, 0, 0)); // Black text

        // Calculate text size and positioning
        final textSize = _calculateTextSize(hdc, value);

        int x = position.xPixels;
        int y = position.yPixels;

        // Apply alignment
        if (field.maxWidth != null) {
          final maxWidthPixels = PrintDimensionCalculator.mmToPixels(
            field.maxWidth!,
            settings.dpi,
          );

          switch (field.alignment.toLowerCase()) {
            case 'center':
              x = position.xPixels + (maxWidthPixels - textSize.width) ~/ 2;
              break;
            case 'right':
              x = position.xPixels + maxWidthPixels - textSize.width;
              break;
            // 'left' is default (no change needed)
          }
        }

        // Render text
        final pText = value.toNativeUtf16();
        TextOut(hdc, x, y, pText, value.length);
        calloc.free(pText);

        // Restore old font and delete created font
        SelectObject(hdc, hOldFont);
        DeleteObject(hFont);
      }

      return true;
    } catch (e) {
      debugPrint('Error rendering template fields: $e');
      return false;
    }
  }

  /// Create font for template field
  int _createFieldFont(TemplateField field, int dpi) {
    // Convert field font size to logical units
    final logicalHeight = -((field.fontSize * dpi) ~/ 72); // Negative for character height

    final fontWeight = field.bold ? FW_BOLD : FW_NORMAL;

    return CreateFont(
      logicalHeight,       // Height
      0,                   // Width (0 = default)
      0,                   // Escapement
      0,                   // Orientation
      fontWeight,          // Weight
      0,                   // Italic
      0,                   // Underline
      0,                   // StrikeOut
      DEFAULT_CHARSET,     // CharSet
      OUT_TT_PRECIS,       // OutPrecision
      CLIP_DEFAULT_PRECIS, // ClipPrecision
      CLEARTYPE_QUALITY,   // Quality
      DEFAULT_PITCH | FF_DONTCARE, // PitchAndFamily
      'Arial'.toNativeUtf16(),      // Face name
    );
  }

  /// Calculate text size for positioning
  SIZE _calculateTextSize(int hdc, String text) {
    final size = calloc<SIZE>();
    final pText = text.toNativeUtf16();

    GetTextExtentPoint32(hdc, pText, text.length, size);

    final result = SIZE(cx: size.ref.cx, cy: size.ref.cy);

    calloc.free(pText);
    calloc.free(size);

    return result;
  }

  /// Test printer connectivity and capabilities
  Future<bool> testPrinter(String printerName) async {
    try {
      final printerDC = await _createPrinterDC(printerName);
      if (printerDC == null) return false;

      // Test by getting device capabilities
      final horSize = GetDeviceCaps(printerDC, HORZSIZE);
      final vertSize = GetDeviceCaps(printerDC, VERTSIZE);
      final horRes = GetDeviceCaps(printerDC, HORZRES);
      final vertRes = GetDeviceCaps(printerDC, VERTRES);

      DeleteDC(printerDC);

      debugPrint('Printer test successful: ${horSize}x${vertSize}mm, ${horRes}x${vertRes}px');
      return horSize > 0 && vertSize > 0 && horRes > 0 && vertRes > 0;
    } catch (e) {
      debugPrint('Printer test failed: $e');
      return false;
    }
  }
}

/// Template field for rendering
class TemplateField {
  final String fieldName;
  final double x; // mm
  final double y; // mm
  final double fontSize;
  final bool bold;
  final String alignment; // 'left', 'center', 'right'
  final double? maxWidth; // mm
  final String? prefix;
  final String? suffix;
  final String? format;

  const TemplateField({
    required this.fieldName,
    required this.x,
    required this.y,
    required this.fontSize,
    this.bold = false,
    this.alignment = 'left',
    this.maxWidth,
    this.prefix,
    this.suffix,
    this.format,
  });
}

/// RGB color helper
int RGB(int r, int g, int b) {
  return r | (g << 8) | (b << 16);
}

/// SIZE structure for text measurements
class SIZE {
  final int cx;
  final int cy;

  const SIZE({required this.cx, required this.cy});

  int get width => cx;
  int get height => cy;
}